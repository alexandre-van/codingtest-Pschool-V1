@page "/parents/add-student"
@using Pschool.Client.Models
@using Pschool.Client.Services
@inject IParentsService ParentsService
@inject FormStateService FormState
@inject NavigationManager Navigation

<h3>Add a student</h3>

<EditForm Model="@student" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <div>
            <label>First Name:</label>
            <InputText @bind-Value="student.FirstName"/>
            <ValidationMessage For="@(() => student.FirstName)"/>
        </div>
        <div>
            <label>Last Name:</label>
            <InputText @bind-Value="student.LastName"/>
            <ValidationMessage For="@(() => student.LastName)"/>
        </div>
        <div>
            <label>Username:</label>
            <InputText @bind-Value="student.Username"/>
        </div>
        <div>
            <label>Email:</label>
            <InputText @bind-Value="student.Email"/>
            <ValidationMessage For="@(() => student.Email)"/>
        </div>
        <div>
            <label>Home Address:</label>
            <InputText @bind-Value="student.HomeAddress"/>
        </div>
        <div>
            <label>Phone1:</label>
            <InputText @bind-Value="student.Phone1"/>
        </div>
        <div>
            <label>Work Phone:</label>
            <InputText @bind-Value="student.WorkPhone"/>
        </div>
        <div>
            <label>Home Phone:</label>
            <InputText @bind-Value="student.HomePhone"/>
        </div>
        <div>
            <label>Siblings:</label>
            <InputNumber @bind-Value="student.Siblings"/>
            <ValidationMessage For="@(() => student.Siblings)"/>
        </div>
    </div>

    <button type="submit">Continue</button>
    <button type="button" @onclick='() => Navigation.NavigateTo("/parents/create")'>
        Go back
    </button>
</EditForm>

@code
{
    private StudentDTO student = new StudentDTO();
    private string message = string.Empty;
    private async Task HandleSubmit()
    {
        var parentAndStudent = new ParentAndStudentDTO
        {
            parent = FormState.ParentBeingCreated,
            student = student
        };
        var success = await ParentsService.CreateParentAndStudentAsync(parentAndStudent);
        if (success)
        {
            Navigation.NavigateTo("/parents/list");
            message = "Parent and student added successfully";
            FormState.Clear();
        }
        else
        {
            message = "Error creating parent and student";
        }
    }
}