@page "/parents/create"
@using Pschool.Client.Models
@using Pschool.Client.Services
@inject IParentsService ParentsService
@inject FormStateService FormState
@inject NavigationManager Navigation

<h3>Add a parent</h3>

<EditForm Model="@parent" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <div>
            <label>First Name:</label>
            <InputText @bind-Value="parent.FirstName"/>
            <ValidationMessage For="@(() => parent.FirstName)"/>
        </div>
        <div>
            <label>Last Name:</label>
            <InputText @bind-Value="parent.LastName"/>
            <ValidationMessage For="@(() => parent.LastName)"/>
        </div>
        <div>
            <label>Username:</label>
            <InputText @bind-Value="parent.Username"/>
        </div>
        <div>
            <label>Email:</label>
            <InputText @bind-Value="parent.Email"/>
            <ValidationMessage For="@(() => parent.Email)"/>
        </div>
        <div>
            <label>Home Address:</label>
            <InputText @bind-Value="parent.HomeAddress"/>
        </div>
        <div>
            <label>Phone1:</label>
            <InputText @bind-Value="parent.Phone1"/>
        </div>
        <div>
            <label>Work Phone:</label>
            <InputText @bind-Value="parent.WorkPhone"/>
        </div>
        <div>
            <label>Home Phone:</label>
            <InputText @bind-Value="parent.HomePhone"/>
        </div>
        <div>
            <label>Siblings:</label>
            <InputNumber @bind-Value="parent.Siblings"/>
            <ValidationMessage For="@(() => parent.Siblings)"/>
        </div>
    </div>

    <button type="submit">Continue</button>
    <button type="button" @onclick='() => Navigation.NavigateTo("/parents/list")'>
        Cancel
    </button>
</EditForm>

@code
{
    private ParentDTO parent = new ParentDTO();
    private string message = string.Empty;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        parent = FormState.ParentBeingCreated ?? new ParentDTO();
    }
    private async Task HandleSubmit()
    {
        FormState.ParentBeingCreated = parent;
        Navigation.NavigateTo("/parents/add-student");
    }
}