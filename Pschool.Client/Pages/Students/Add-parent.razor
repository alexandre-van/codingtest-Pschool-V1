@page "/students/add-parent"

@using Pschool.Client.Models
@using Pschool.Client.Services
@inject IStudentsService StudentsService
@inject FormStateService FormState
@inject NavigationManager Navigation

<h3>Add a parent</h3>

<EditForm Model="@parentDTO" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <div>
            <label>First Name:</label>
            <InputText @bind-Value="parentDTO.FirstName"/>
            <ValidationMessage For="@(() => parentDTO.FirstName)"/>
        </div>
        <div>
            <label>Last Name:</label>
            <InputText @bind-Value="parentDTO.LastName"/>
            <ValidationMessage For="@(() => parentDTO.LastName)"/>
        </div>
        <div>
            <label>Username:</label>
            <InputText @bind-Value="parentDTO.Username"/>
        </div>
        <div>
            <label>Email:</label>
            <InputText @bind-Value="parentDTO.Email"/>
            <ValidationMessage For="@(() => parentDTO.Email)"/>
        </div>
        <div>
            <label>Home Address:</label>
            <InputText @bind-Value="parentDTO.HomeAddress"/>
        </div>
        <div>
            <label>Phone1:</label>
            <InputText @bind-Value="parentDTO.Phone1"/>
        </div>
        <div>
            <label>Work Phone:</label>
            <InputText @bind-Value="parentDTO.WorkPhone"/>
        </div>
        <div>
            <label>Home Phone:</label>
            <InputText @bind-Value="parentDTO.HomePhone"/>
        </div>
        <div>
            <label>Siblings:</label>
            <InputNumber @bind-Value="parentDTO.Siblings"/>
            <ValidationMessage For="@(() => parentDTO.Siblings)"/>
        </div>
    </div>

    <button type="submit">Add</button>
    <button type="button" @onclick='() => Navigation.NavigateTo("/students/create")'>
        Go back
    </button>
</EditForm>

@code
{
    private ParentDTO parentDTO = new ParentDTO();
    private string message = string.Empty;
    private async Task HandleSubmit()
    {
        var parentAndStudent = new ParentAndStudentDTO
        {
            parent = parentDTO,
            student = FormState.StudentBeingCreated
        };
        var success = await StudentsService.CreateParentAndStudentAsync(parentAndStudent);
        if (success)
        {
            Navigation.NavigateTo("/students/list");
            message = "Parent and student added successfully";
            FormState.Clear();
        }
        else
        {
            message = "Error creating parent and student";
        }
    }
}