@page "/parents/edit/{parentId:int}"
@using Pschool.Client.Models
@using Pschool.Client.Services
@inject IParentsService ParentsService
@inject NavigationManager Navigation

<h3>Edit a parent</h3>

<EditForm Model="@parentDTO" OnValidSubmit="EditParent">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <div>
            <label>First Name:</label>
            <InputText @bind-Value="parentDTO.FirstName"/>
            <ValidationMessage For="@(() => parentDTO.FirstName)"/>
        </div>
        <div>
            <label>Last Name:</label>
            <InputText @bind-Value="parentDTO.LastName"/>
            <ValidationMessage For="@(() => parentDTO.LastName)"/>
        </div>
        <div>
            <label>Username:</label>
            <InputText @bind-Value="parentDTO.Username"/>
        </div>
        <div>
            <label>Email:</label>
            <InputText @bind-Value="parentDTO.Email"/>
            <ValidationMessage For="@(() => parentDTO.Email)"/>
        </div>
        <div>
            <label>Home Address:</label>
            <InputText @bind-Value="parentDTO.HomeAddress"/>
        </div>
        <div>
            <label>Phone1:</label>
            <InputText @bind-Value="parentDTO.Phone1"/>
        </div>
        <div>
            <label>Work Phone:</label>
            <InputText @bind-Value="parentDTO.WorkPhone"/>
        </div>
        <div>
            <label>Home Phone:</label>
            <InputText @bind-Value="parentDTO.HomePhone"/>
        </div>
        <div>
            <label>Siblings:</label>
            <InputNumber @bind-Value="parentDTO.Siblings"/>
            <ValidationMessage For="@(() => parentDTO.Siblings)"/>
        </div>
    </div>

    <button type="submit">Edit</button>
    <button type="button" @onclick='() => Navigation.NavigateTo("/parents/list")'>
        Cancel
    </button>
</EditForm>

@code
{
    [Parameter]
    public int ParentId { get; set; }

    private ParentDTO parentDTO = new ParentDTO();
    private string message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        parentDTO = await ParentsService.GetParentAsync(ParentId);
    }
    private async Task EditParent()
    {
        var success = await ParentsService.EditParentAsync(ParentId, parentDTO);
        if (success)
        {
            Navigation.NavigateTo("/parents/list");
            message = "Parent edited successfully";
        }
        else
        {
            message = "Error editing parent";
        }
    }
}